<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Suite" parallel="tests">

    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="test.LoginLogoutTest"/>
            <class name="test.LoginTest"/>
            <class name="test.ProductPageTest"/>
            <class name="test.CartPageTest"/>
            <class name="test.AddMultipleProductsTest"/>
            <class name="test.FilterValidationTest"/>
            <class name="test.ProductOrderedSuccessfullyWithNameAndPrices"/>
            <class name="test.ProductOrderSuccessfullyTest"/>
            <class name="test.ProductPageTest"/>
            <class name="test.ProductPageValidation"/>
        </classes>
    </test>
    <test name="Firefox Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="test.LoginLogoutTest"/>
            <class name="test.LoginTest"/>
            <class name="test.ProductPageTest"/>
            <class name="test.CartPageTest"/>
            <class name="test.AddMultipleProductsTest"/>
            <class name="test.FilterValidationTest"/>
            <class name="test.ProductOrderedSuccessfullyWithNameAndPrices"/>
            <class name="test.ProductOrderSuccessfullyTest"/>
            <class name="test.ProductPageTest"/>
            <class name="test.ProductPageValidation"/>
        </classes>
    </test>
    <test name="Edge Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="test.LoginLogoutTest"/>
            <class name="test.LoginTest"/>
            <class name="test.ProductPageTest"/>
            <class name="test.CartPageTest"/>
            <class name="test.AddMultipleProductsTest"/>
            <class name="test.FilterValidationTest"/>
            <class name="test.ProductOrderedSuccessfullyWithNameAndPrices"/>
            <class name="test.ProductOrderSuccessfullyTest"/>
            <class name="test.ProductPageTest"/>
            <class name="test.ProductPageValidation"/>
        </classes>
    </test>
</suite>
	